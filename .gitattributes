# Normalize line endings: store text as LF in the repo and check out LF on every
# platform. This prevents Windows CRLF checkouts from producing prettier/prettier
# ("Delete CR") lint failures that only surface on the Linux CI runner.
* text=auto eol=lf

# Binary assets — never normalize or diff as text.
*.png  binary
*.jpg  binary
*.jpeg binary
*.gif  binary
*.webp binary
*.ico  binary
*.pdf  binary
*.woff  binary
*.woff2 binary

# Generated file — keep diffs out of review noise.
visaflow-assistant-main/src/routeTree.gen.ts linguist-generated=true

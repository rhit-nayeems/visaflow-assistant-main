VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=your-supabase-anon-key
VITE_AUTH_REDIRECT_ORIGIN=https://your-app-domain.com
APP_URL=https://your-app-domain.com
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_PUBLISHABLE_KEY=your-supabase-anon-key
# Optional unless you add server-side admin flows that import src/integrations/supabase/client.server.ts
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key
# Optional: enables Claude-powered document extraction. Without it, the local text-pattern stub is used.
ANTHROPIC_API_KEY=your-anthropic-api-key
# Optional: override the extraction model (defaults to claude-haiku-4-5)
ANTHROPIC_EXTRACTION_MODEL=claude-haiku-4-5
